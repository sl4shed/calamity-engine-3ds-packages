pkgname=3ds-sdl3_ttf
pkgver=3.2.2
pkgrel=2
pkgdesc="A sample library which allows you to use TrueType fonts in your SDL applications (Nintendo 3DS port)"
arch=('any')
url="https://github.com/libsdl-org/SDL_ttf"
license=("LGPL")
options=(!strip libtool staticlibs)
depends=(
	'3ds-freetype'
	'3ds-sdl3'
	'3ds-zlib'
)
makedepends=(
	'3ds-pkg-config'
	'dkp-toolchain-vars'
)
source=("${url}/releases/download/release-${pkgver}/SDL3_ttf-${pkgver}.tar.gz")
groups=('3ds-portlibs' '3ds-sdl-libs')
sha256sums=('SKIP')

prepare() {
	source /opt/devkitpro/3dsvars.sh
	cmake -S "SDL3_ttf-$pkgver" -B build \
		-DCMAKE_TOOLCHAIN_FILE="$DEVKITPRO/cmake/3DS.cmake" \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX="${PORTLIBS_PREFIX}" \
		-DCMAKE_PREFIX_PATH="${PORTLIBS_PREFIX}" \
		-DSDLTTF_PLUTOSVG=OFF \
		-DSDLTTF_SAMPLES=OFF \
		-DBUILD_SHARED_DEPS=OFF
}

build() {
	source /opt/devkitpro/3dsvars.sh
	cmake --build build
}

package() {
	source /opt/devkitpro/3dsvars.sh
	DESTDIR="$pkgdir" cmake --install build
}
