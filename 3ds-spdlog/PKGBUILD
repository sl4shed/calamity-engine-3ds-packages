pkgname=3ds-spdlog
pkgver=1.17.0
pkgrel=1
pkgdesc="Very fast, header only, C++ logging library"
arch=(any)
url="https://github.com/gabime/spdlog"
license=(MIT)
depends=('3ds-fmt')
makedepends=('dkp-toolchain-vars' '3ds-pkg-config')
provides=()
conflicts=()
groups=('3ds-portlibs')
options=('!strip' 'staticlibs' '!buildflags')
source=("https://github.com/gabime/spdlog/archive/refs/tags/v1.17.0.zip"
        "spdlog-3ds.patch")
sha256sums=('b11912a82d149792fef33fabd0503b13d54aeac25c1464755461d4108ea71fc2'
            'SKIP')

prepare() {
  cd "spdlog-$pkgver"
  patch -p1 < ../spdlog-3ds.patch

  # patch spdlog.pc.in
  # sed -i 's/@CMAKE_INSTALL_PREFIX@/${PSPDEV}\/psp/' ./cmake/spdlog.pc.in
}

build() {
  source $DEVKITPRO/devkitarm.sh
  source $DEVKITPRO/3dsvars.sh

  arm-none-eabi-cmake -B build -S "spdlog-$pkgver" -Wno-dev \
    -DCMAKE_TOOLCHAIN_FILE="${DEVKITPRO}/cmake/3DS.cmake" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="${PORTLIBS_PREFIX}" \
    -DSPDLOG_BUILD_BENCH=OFF \
    -DSPDLOG_BUILD_EXAMPLE=OFF \
    -DSPDLOG_BUILD_TESTS=OFF \
    -DSPDLOG_BUILD_SHARED=OFF \
    -DSPDLOG_FMT_EXTERNAL=ON \
    -DSPDLOG_NO_THREAD_ID=ON \
    -DSPDLOG_NO_ATOMIC_LEVELS=ON \
    -DSPDLOG_NO_EXCEPTIONS=ON
  arm-none-eabi-cmake --build build
}

package() {
  source $DEVKITPRO/devkitarm.sh
  source $DEVKITPRO/3dsvars.sh

  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 spdlog-$pkgver/LICENSE -t "$pkgdir${PORTLIBS_PREFIX}/share/licenses/${pkgname}"
}
