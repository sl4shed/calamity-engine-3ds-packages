pkgname=3ds-cereal
pkgver=1.3.2
pkgrel=1
pkgdesc="A C++11 library for serialization"
arch=('any')
url="https://github.com/USCiLab/cereal"
license=('BSD-3-Clause')
depends=()
makedepends=('dkp-toolchain-vars' '3ds-pkg-config')
provides=()
conflicts=()
options=('!strip' 'staticlibs')
groups=('3ds-portlibs')
source=("${url}/archive/refs/tags/v${pkgver}.zip")
sha256sums=("SKIP")

prepare() {
    source /opt/devkitpro/3dsvars.sh
    arm-none-eabi-cmake -B build -S "cereal-$pkgver" -Wno-dev \
        -DCMAKE_TOOLCHAIN_FILE="$DEVKITPRO/cmake/3DS.cmake" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="${PORTLIBS_PREFIX}" \
        -DSKIP_PERFORMANCE_COMPARISON=ON \
        -DBUILD_DOC=OFF \
        -DBUILD_SANDBOX=OFF \
        -DBUILD_TESTS=OFF
}

build() {
    source /opt/devkitpro/3dsvars.sh
    arm-none-eabi-cmake --build build
}

package() {
    source $DEVKITPRO/3dsvars.sh
	DESTDIR="$pkgdir" arm-none-eabi-cmake --install build
}
