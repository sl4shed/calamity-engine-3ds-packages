pkgname=3ds-sdl3
pkgver=3.4.12
pkgrel=19
pkgdesc="A library for portable low-level access to a video framebuffer, audio output, mouse, and keyboard (Nintendo 3DS port)"
arch=('any')
url="https://github.com/libsdl-org/SDL"
license=("LGPL")
options=(!strip libtool staticlibs)
makedepends=('3ds-pkg-config' 'dkp-toolchain-vars')
source=("${url}/releases/download/release-${pkgver}/SDL3-${pkgver}.tar.gz")
sha256sums=('SKIP')
# /releases/download/release-3.4.12/SDL3-3.4.12.zip
groups=('3ds-portlibs' '3ds-sdl-libs')

prepare() {
	source /opt/devkitpro/3dsvars.sh
	cmake -S "SDL3-$pkgver" -B build \
		-DCMAKE_TOOLCHAIN_FILE="$DEVKITPRO/cmake/3DS.cmake" \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX="${PORTLIBS_PREFIX}" \
		-DCMAKE_PREFIX_PATH="${PORTLIBS_PREFIX}" \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_SHARED_DEPS=OFF
}

build() {
	source /opt/devkitpro/3dsvars.sh
	cmake --build build
}

package() {
	source /opt/devkitpro/3dsvars.sh
	DESTDIR="$pkgdir" cmake --install build
}
