pkgbasename=box2d
pkgname=3ds-$pkgbasename
pkgver=3.1.1
pkgrel=1
pkgdesc='Box2D is a 2D physics engine for games.'
arch=('any')
url='https://github.com/erincatto/box2d'
license=(MIT)
options=(!strip libtool staticlibs)
source=("${url}/archive/refs/tags/v${pkgver}.zip")
sha256sums=('7c88bef902a118a2933c21027918fea455237a1310e5422daf4640d22ba9a446')
makedepends=('dkp-toolchain-vars' '3ds-cmake')
groups=('3ds-portlibs')

build() {
    cd ${pkgbasename}-${pkgver}

    source /opt/devkitpro/3dsvars.sh

    arm-none-eabi-cmake \
        -DCMAKE_INSTALL_PREFIX=$PORTLIBS_PREFIX \
        -DBOX2D_DOCS=OFF \
        -DBOX2D_UNIT_TESTS=OFF \
        -DBOX2D_BUILD_TESTBED=OFF \
        -DBOX2D_SAMPLES=OFF \
        -DBOX2D_BENCHMARKS=OFF \
        -DBOX2D_PROFILE=OFF \
        -DBOX2D_VALIDATE=OFF \
        -DBOX2D_DISABLE_SIMD=ON \
        .

    make
}

package() {
  cd ${pkgbasename}-${pkgver}

  make install 
}
