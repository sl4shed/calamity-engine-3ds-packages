pkgname=3ds-sdl3_image
pkgver=3.4.4
pkgrel=3
pkgdesc="A simple library to load images of various formats as SDL surfaces (Nintendo 3DS port)"
arch=('any')
url="https://github.com/libsdl-org/SDL_image/"
license=("LGPL")
options=(!strip libtool staticlibs)
depends=(
 '3ds-sdl3'
 '3ds-libpng'
 '3ds-libjpeg-turbo'
)
makedepends=(
 '3ds-pkg-config'
 'dkp-toolchain-vars'
)
groups=('3ds-portlibs' '3ds-sdl-libs')
source=("${url}/releases/download/release-${pkgver}/SDL3_image-${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
 source /opt/devkitpro/3dsvars.sh
  cmake -S "SDL3_image-$pkgver" -B build \
    -DCMAKE_TOOLCHAIN_FILE="$DEVKITPRO/cmake/3DS.cmake" \
	-DCMAKE_PREFIX_PATH="${PORTLIBS_PREFIX}" \
	-DCMAKE_INSTALL_PREFIX="${PORTLIBS_PREFIX}" \
	-DCMAKE_BUILD_TYPE=Release \
    -DSDLIMAGE_DEPS_SHARED=OFF \
	-DSDLIMAGE_SAMPLES=OFF \
	-DSDLIMAGE_VENDORED=OFF \
	-DBUILD_SHARED_DEPS=OFF \
	-DBUILD_SHARED_LIBS=OFF \
	-DSDL3_DIR="${PORTLIBS_PREFIX}/lib/cmake/SDL3" \
	-DSDL3IMAGE_SDL3_SHARED=OFF \
	-DSDLIMAGE_BUILD_SHARED_LIBS=OFF
}

build() {
  source /opt/devkitpro/3dsvars.sh
  cmake --build build
}

package() {
  source /opt/devkitpro/3dsvars.sh
  DESTDIR="$pkgdir" cmake --install build
}
